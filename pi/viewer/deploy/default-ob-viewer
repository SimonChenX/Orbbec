# Orbbec 彩色/深度预览服务 —— 可调参数
# 改完执行：systemctl restart ob-viewer
# 注释掉某行即用代码内默认值。
#
# ⚠️ 这几个默认值是**实测调优**出来的，别随手改大 —— 见 docs/07 §5「CPU 调优」。
#    树莓派 4 核，当前配置下系统约 50% 空闲。

# --- HTTP ---
# 只监听本机（kiosk 同机访问）。想让局域网里别的机器也能看，改成 0.0.0.0
OB_VIEW_BIND=127.0.0.1
OB_VIEW_PORT=8790

# --- 彩色（UVC /dev/video0）---
# 屏上面板只有 ~376px 宽：640x480(4:3) 显示得**比 720p(16:9) 更大**，而流量只有 1/3。
# 720p 帧 130KB/帧(3.8MB/s) vs 640x480 的 51KB/帧(1.5MB/s)。
OB_COLOR_DEV=/dev/video0
OB_COLOR_SIZE=640x480
OB_COLOR_FPS=30
# 2026-10-14 实测（树莓派机位）：原帧本来就是正立的，不要旋转。
# 旧文档的「必须 180°」来自橙子派机位，在本机不成立。
OB_ROTATE_COLOR=0

# --- 深度（Orbbec SDK v1）---
# ⭐ 320x240 是省 CPU 的关键：深度引擎按流分辨率算深度，640x480 时它一个人吃掉一个多核；
#    降到 320x240 后系统空闲从 7% → 54%。屏上面板仅 376px 宽，看不出差别。
#    设备侧 640x480 只提供 @30，所以「降流分辨率」比「降渲染帧率」有效得多。
OB_DEPTH_SIZE=320x240
OB_DEPTH_FPS=30
# 实测（几何判据：俯拍桌面时远端在画面上方、近端在下方）深度原帧也是正立的，不要旋转。
OB_ROTATE_DEPTH=0

# --- 画质 ---
OB_JPEG_Q=70